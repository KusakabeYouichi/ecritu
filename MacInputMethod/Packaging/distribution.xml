<?xml version="1.0" encoding="utf-8"?>
<!-- productbuild に渡す。入れ先を [すべてのユーザ用] と [自分専用] から選べるようにする。
     @PKG_ID@ @VERSION@ @COMPONENT@ は tools/package_mac_input_method.sh が置き換える -->
<installer-gui-script minSpecVersion="2">
    <title>écritu</title>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="écritu">
        <pkg-ref id="@PKG_ID@"/>
    </choice>
    <pkg-ref id="@PKG_ID@" version="@VERSION@" onConclusion="none">@COMPONENT@</pkg-ref>
</installer-gui-script>
